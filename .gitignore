.DS_Store
.idea/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.streamlit/
data/processed/

# Fitted models are rebuilt by the notebooks
deployment/models/*.joblib
# ...except the final model, which the deployed app loads.
!deployment/models/regression_final_model.joblib

# Keep the generated deployment holdout while ignoring any other app data.
data/app/*
!data/app/regression_holdout.csv.gz
